# Copia in .env (mai committato) e compila i valori.
LLM_PROVIDER=mock            # mock | locale o openai_compat (LM Studio sull'Air) | cloud (riserva)
LLM_BASE_URL=                # es. http://<IP-dell-Air>:1234/v1
LLM_MODEL=qwen/qwen3-30b-a3b-2507
LLM_API_KEY=
LLM_TEMPERATURE=0.3
LLM_TIMEOUT=120              # secondi per chiamata
LLM_REGISTRA=0               # 1 = salva le risposte vere in dati/mock_llm/ (diventano il mock)
ELEVENLABS_API_KEY=

# Posta: finta (mail sintetiche della demo) | gmail | outlook (non ancora collegati: rispondono 503)
POSTA_PROVIDER=finta
